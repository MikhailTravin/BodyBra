<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Личный кабинет - главная</title>
    {% include 'blocks/head.njk' %}
</head>

<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            <div class="block-account">
                <div class="container">
                    <div class="block-account__contents">
                        <div class="breadcrumbs">
                            <ul>
                                <li>
                                    <a href="#" class="home">
                                        <img src="img/icons/home.svg" alt="">
                                    </a>
                                </li>
                                <li><span>Войти</span></li>
                            </ul>
                        </div>
                        <div class="block-account__content">
                            <div class="account-menu">
                                <ul>
                                    <li>
                                        <a href="./" class="active">
                                            <img src="img/icons/user1.svg" alt="">
                                            <span>Главная</span>
                                        </a>
                                        <a href="./">
                                            <img src="img/icons/sale-percent.svg" alt="">
                                            <span>Моя скидка</span>
                                        </a>
                                        <a href="./">
                                            <img src="img/icons/history.svg" alt="">
                                            <span>История заказов</span>
                                        </a>
                                        <a href="./">
                                            <img src="img/icons/heart.svg" alt="">
                                            <span>Избранное</span>
                                        </a>
                                        <a href="./">
                                            <img src="img/icons/info.svg" alt="">
                                            <span>Личные данные</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="./" class="logout">
                                            <span>Выйти</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <div class="block-account__body">
                                <div class="block-account__top">
                                    <h1 class="title1">
                                        Здравствуйте, Анна
                                    </h1>
                                </div>
                                <div class="account-home">
                                    <div class="account-home__left">
                                        <div class="account-home__column">
                                            <div class="account-home__name">
                                                Заказ №12345 от 10 октября
                                            </div>
                                            <div class="account-home__title">
                                                В пути. Ожидается 14 октября
                                            </div>
                                            <div class="account-home__delivery">
                                                <img src="img/icons/truck-delivery.svg" alt="">
                                                <span>Доставка в ПВЗ Ozon</span>
                                            </div>
                                        </div>
                                        <div class="account-home__column">
                                            <div class="account-home__name">
                                                Заказ №12345 от 08 октября
                                            </div>
                                            <div class="account-home__title">
                                                В пути. Ожидается 22 октября
                                            </div>
                                            <div class="account-home__delivery">
                                                <img src="img/icons/truck-delivery.svg" alt="">
                                                <span>Доставка в ПВЗ Ozon</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="account-home-sale">
                                        <img src="img/card.webp" alt="" class="account-home-sale__pic1">
                                        <div class="account-home-sale__item">
                                            <div class="account-home-sale__title">
                                                Ваша постоянная скидка:
                                            </div>
                                            <div class="account-home-sale__number">5%</div>
                                            <a href="./" class="account-home-sale__link">
                                                <span>Подробнее о программе лояльности</span>
                                                <svg aria-hidden="true" width="6" height="11">
                                                    <use xlink:href="img/sprite.svg#arrow1"></use>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/popups.njk' %}
    {% include 'blocks/scripts.njk' %}
</body>

</html>