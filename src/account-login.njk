<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Личный кабинет - вход</title>
    {% include 'blocks/head.njk' %}
</head>

<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            <div class="block-main block-main-forms">
                <div class="container">
                    <div class="block-main__content">
                        <div class="heading-complex">
                            <div class="breadcrumbs">
                                <ul>
                                    <li>
                                        <a href="#" class="home">
                                            <img src="img/icons/home.svg" alt="">
                                        </a>
                                    </li>
                                    <li><span>Войти</span></li>
                                </ul>
                            </div>
                            <h1 class="title1">Войти или создать аккаунт</h1>
                            <a href="./" class="btn">
                                <span>Войти через Яндекс ID</span>
                            </a>
                        </div>
                        <div class="block-main-forms__center">
                            <div class="block-main-forms__line"></div>
                            <span>или</span>
                            <div class="block-main-forms__line"></div>
                        </div>
                        <form action="#" data-dev data-popup-message="#thanks" class="form">
                            <div class="form__inputs">
                                <div class="form__input">
                                    <img loading="lazy" src="img/icons/mail1.svg" alt="">
                                    <input data-required autocomplete="off" type="text" name="form[]"
                                        placeholder="Email" class="input">
                                </div>
                                <div class="form__input">
                                    <img loading="lazy" src="img/icons/lock.svg" alt="">
                                    <input data-required autocomplete="off" type="password" name="form[]"
                                        placeholder="Пароль" class="input">
                                    <button type="button" class="form__viewpass">
                                        <img src="img/icons/eye1.svg" alt="" class="icon1">
                                        <img src="img/icons/eye2.svg" alt="" class="icon2">
                                    </button>
                                </div>
                            </div>
                            <div class="form__buttons">
                                <button type="submit" class="btn btn-border-brown">
                                    <span>Войти</span>
                                </button>
                                <div class="form__links">
                                    <a href="./" class="form__link">Забыли пароль?</a>
                                    <a href="./" class="form__link">
                                        <span>Зарегистрироваться</span>
                                        <svg aria-hidden="true" width="6" height="11">
                                            <use xlink:href="img/sprite.svg#arrow1"></use>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/popups.njk' %}
    {% include 'blocks/scripts.njk' %}
</body>

</html>