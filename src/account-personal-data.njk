<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Личный кабинет - личные данные</title>
    {% include 'blocks/head.njk' %}
</head>

<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            {% include 'blocks/header-search.njk' %}

            <div class="block-account">
                <div class="container">
                    <div class="block-account__contents">
                        <div class="breadcrumbs">
                            <ul>
                                <li>
                                    <a href="#" class="home">
                                        <img src="img/icons/home.svg" alt="">
                                    </a>
                                </li>
                                <li><span>Личный кабинет</span></li>
                            </ul>
                        </div>
                        <div class="block-account__content">
                            <div class="account-menu">
                                <ul>
                                    <li>
                                        <a href="./">
                                            <img src="img/icons/user1.svg" alt="">
                                            <span>Главная</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="./">
                                            <img src="img/icons/sale-percent.svg" alt="">
                                            <span>Моя скидка</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="./">
                                            <img src="img/icons/history.svg" alt="">
                                            <span>История заказов</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="./">
                                            <img src="img/icons/heart.svg" alt="">
                                            <span>Избранное</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="./" class="active">
                                            <img src="img/icons/info.svg" alt="">
                                            <span>Личные данные</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="./" class="logout">
                                            <span>Выйти</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <div class="block-account__body">
                                <div class="block-account__top">
                                    <h1 class="title1">
                                        Личные данные
                                    </h1>
                                </div>
                                <div class="account-personal-data">
                                    <div class="account-personal-data__forms">
                                        <form action="#" data-dev data-popup-message="#thanks" class="form">
                                            <div class="form__inputs">
                                                <div class="form__input">
                                                    <img loading="lazy" src="img/icons/user1.svg" alt="">
                                                    <input data-required autocomplete="off" type="text" name="form[]"
                                                        placeholder="Имя" class="input">
                                                </div>
                                                <div class="form__input">
                                                    <img loading="lazy" src="img/icons/user1.svg" alt="">
                                                    <input data-required autocomplete="off" type="text" name="form[]"
                                                        placeholder="Фамилия" class="input">
                                                </div>
                                                <div class="form__input">
                                                    <img loading="lazy" src="img/icons/mail1.svg" alt="">
                                                    <input data-required autocomplete="off" type="text" name="form[]"
                                                        placeholder="Электронная почта" class="input">
                                                </div>
                                                <div class="form__input">
                                                    <img loading="lazy" src="img/icons/phone.svg" alt="">
                                                    <input data-required autocomplete="off" type="text" name="form[]"
                                                        placeholder="Телефон" class="input">
                                                </div>
                                            </div>
                                            <div class="form__buttons">
                                                <button type="submit" class="btn">
                                                    <span>Сохранить изменения</span>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="account-personal-data__address">
                                        <h2 class="title2">
                                            Мои адреса доставки
                                        </h2>
                                        <div class="account-personal-data__body">
                                            <div class="account-personal-data__column">
                                                <button type="button" class="account-personal-data__delete">
                                                    <svg aria-hidden="true" width="10" height="10">
                                                        <use xlink:href="img/sprite.svg#close"></use>
                                                    </svg>
                                                </button>
                                                <div class="account-personal-data__image">
                                                    <img loading="lazy" src="img/ozon1.webp" alt="">
                                                </div>
                                                <div class="account-personal-data__item">
                                                    <div class="account-personal-data__name">
                                                        ПВЗ Ozon
                                                    </div>
                                                    <div class="account-personal-data__text">
                                                        г. Москва, ул. Ленина, д. 45
                                                    </div>
                                                </div>
                                            </div>
                                            <a href="./" class="account-personal-data__column">
                                                <div class="account-personal-data__add">
                                                    <div class="account-personal-data__icon">
                                                        <span></span>
                                                    </div>
                                                    <p>
                                                        Добавить пункт выдачи
                                                    </p>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="account-personal-data__forms">
                                        <div class="account-personal-data__title">
                                            Безопасность
                                        </div>
                                        <form action="#" data-dev data-popup-message="#thanks" class="form">
                                            <div class="form__inputs">
                                                <div class="form__input form-inputs-grid">
                                                    <img loading="lazy" src="img/icons/lock.svg" alt="">
                                                    <input data-required autocomplete="off" type="password"
                                                        name="form[]" placeholder="Текущий пароль" class="input">
                                                    <button type="button" class="form__viewpass">
                                                        <img src="img/icons/eye1.svg" alt="" class="icon1">
                                                        <img src="img/icons/eye2.svg" alt="" class="icon2">
                                                    </button>
                                                </div>
                                                <div class="form__input">
                                                    <img loading="lazy" src="img/icons/lock.svg" alt="">
                                                    <input data-required autocomplete="off" type="password"
                                                        name="form[]" placeholder="Новый пароль" class="input">
                                                    <button type="button" class="form__viewpass">
                                                        <img src="img/icons/eye1.svg" alt="" class="icon1">
                                                        <img src="img/icons/eye2.svg" alt="" class="icon2">
                                                    </button>
                                                </div>
                                                <div class="form__input">
                                                    <img loading="lazy" src="img/icons/lock.svg" alt="">
                                                    <input data-required autocomplete="off" type="password"
                                                        name="form[]" placeholder="Повторите новый пароль"
                                                        class="input">
                                                    <button type="button" class="form__viewpass">
                                                        <img src="img/icons/eye1.svg" alt="" class="icon1">
                                                        <img src="img/icons/eye2.svg" alt="" class="icon2">
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="form__buttons">
                                                <button type="submit" class="btn">
                                                    <span>Обновить пароль</span>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="account-personal-data__forms">
                                        <div class="account-personal-data__title">
                                            Настройки уведомлений
                                        </div>
                                        <div class="checkbox">
                                            <label class="checkbox__item">
                                                <input checked hidden class="checkbox__input" type="checkbox" value="1"
                                                    name="checkbox1">
                                                <span class="checkbox__label">
                                                    <span class="checkbox__icon"></span>
                                                    <span
                                                        data-text="Присылать мне информацию о статусе заказов на электронную почту"
                                                        class="checkbox__text">
                                                        Присылать мне информацию о статусе заказов на электронную почту
                                                    </span>
                                                </span>
                                            </label>
                                            <label class="checkbox__item">
                                                <input hidden class="checkbox__input" type="checkbox" value="2"
                                                    name="checkbox1">
                                                <span class="checkbox__label">
                                                    <span class="checkbox__icon"></span>
                                                    <span
                                                        data-text="Я хочу первой узнавать о новых коллекциях и закрытых распродажах"
                                                        class="checkbox__text">
                                                        Я хочу первой узнавать о новых коллекциях и закрытых распродажах
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/popups.njk' %}
    {% include 'blocks/scripts.njk' %}
</body>

</html>